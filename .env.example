PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/aurigin-media?appName=Cluster0
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
JWT_SECRET=<random-long-secret>

# AI for "My Day" planning and end-of-day reviews (Groq, OpenAI-compatible).
# Optional: without a key, plans fall back to one ticket per line and days
# close without an AI review.
GROQ_API_KEY=
GROQ_MODEL=

# File attachments on issues and comments (Cloudinary). The secret stays on
# the server; browsers upload with a short-lived signature from /api/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing email (Gmail SMTP). SMTP_PASS must be a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords), not the
# account password. Without it, emails are skipped and logged.
SMTP_USER=
SMTP_PASS=
# The portal's public URL, used for links in emails.
APP_URL=
# Secret for the nightly auto-review (Vercel Cron sends it as a bearer token).
# Any long random string; without it the cron endpoint refuses every call.
CRON_SECRET=
